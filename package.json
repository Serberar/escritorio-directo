{
  "name": "escritorio-remoto",
  "version": "0.3.0",
  "description": "Escritorio remoto por ID, directo y sin servidor",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js test/regression.test.js test/wan.test.js",
    "e2e": "node test/e2e.js",
